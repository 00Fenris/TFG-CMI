{
  "name": "tfg-cmi-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "electron .",
    "dev": "concurrently \"cd ../frontend && npm start\" \"cd ../backend && npm run dev\" \"electron .\" || true",
    "package": "electron-builder --win --x64 --publish=never"
  },
  "description": "TFG-CMI Electron desktop wrapper (bundles backend + frontend)",
  "author": "00Fenris",
  "devDependencies": {
    "concurrently": "^8.0.1",
    "electron": "26.6.10",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.clauna.cmi",
    "productName": "TFG-CMI",
    "files": [
      "app/**/*",
      "main.js",
      "prepare.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
