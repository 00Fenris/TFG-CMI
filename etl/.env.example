# ─────────────────────────────────────────────────────────────────────
# ETL Claunafood — Variables de entorno
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el .env real a Git.
# ─────────────────────────────────────────────────────────────────────

# Carpeta del NAS donde caen los PDFs de caja (ruta en Nodo B / Windows)
NAS_FACTURAS_PATH=F:\CerebroNAS\Facturas

# Archivo de log de PDFs ya procesados (para no reprocesar)
PROCESSED_LOG=F:\CerebroNAS\scripts\processed.log

# ── Base de datos PostgreSQL (CMI) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmi
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_AQUI

# ── Telegram (OpenClaw) ───────────────────────────────────────────────
# Obtén el token con @BotFather en Telegram
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tu chat ID personal (usa @userinfobot para saberlo)
TELEGRAM_CHAT_ID=123456789
